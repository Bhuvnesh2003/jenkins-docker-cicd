pipeline {
    agent any

    environment {
        IMAGE_NAME = "localhost/jenkins-docker-cicd"
        IMAGE_TAG = "devsecops-${BUILD_NUMBER}"
        REPORT_DIR = "security-reports"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    set -eu
                    test -f index.html
                    test -f Dockerfile
                    test -f nginx.conf
                    echo "Application files verified."
                '''
            }
        }

        stage('Build Secure Image') {
            steps {
                sh '''
                    set -eu
                    podman build -t "$IMAGE_NAME:$IMAGE_TAG" .
                '''
            }
        }

        stage('Export Image') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$REPORT_DIR"
                    podman save \
                      -o "$REPORT_DIR/image.tar" \
                      "$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }

        stage('Trivy Security Scan') {
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    sh '''
                        trivy image \
                          --input "$REPORT_DIR/image.tar" \
                          --severity HIGH,CRITICAL \
                          --exit-code 1 \
                          --format json \
                          --output "$REPORT_DIR/trivy-report.json"
                    '''
                }
            }
        }

        stage('Archive Security Report') {
            steps {
                archiveArtifacts artifacts: 'security-reports/trivy-report.json',
                                 allowEmptyArchive: false
            }
        }
    }

    post {
        success {
            echo 'DevSecOps pipeline passed: no HIGH/CRITICAL findings.'
        }
        failure {
            echo 'Pipeline failed. Review the build and Trivy report.'
        }
        always {
            sh 'rm -f security-reports/image.tar'
        }
    }
}
EOF
