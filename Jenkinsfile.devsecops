pipeline {
    agent any

    environment {
        IMAGE_NAME = "localhost/jenkins-docker-cicd"
        IMAGE_TAG = "devsecops-${BUILD_NUMBER}"
        REPORT_DIR = "security-reports"
        TEST_CONTAINER = "production-review-test-${BUILD_NUMBER}"
        TEST_PORT = "18090"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    set -eu
                    test -f index.html
                    test -f Dockerfile
                    test -f nginx.conf
                    echo "Application files verified."
                '''
            }
        }

        stage('Build Secure Image') {
            steps {
                sh '''
                    set -eu
                    podman build --no-cache -t "$IMAGE_NAME:$IMAGE_TAG" .
                '''
            }
        }

        stage('Export Image') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$REPORT_DIR"
                    podman save \
                      -o "$REPORT_DIR/image.tar" \
                      "$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image \
                      --input "$REPORT_DIR/image.tar" \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      --format json \
                      --output "$REPORT_DIR/trivy-report.json"
                '''
            }
        }

        stage('Runtime Health Check') {
            steps {
                sh '''
                    set -eu

                    cleanup() {
                        podman rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true
                    }
                    trap cleanup EXIT

                    podman run -d \
                      --name "$TEST_CONTAINER" \
                      -p "127.0.0.1:${TEST_PORT}:8080" \
                      "$IMAGE_NAME:$IMAGE_TAG"

                    attempt=0
                    until curl -fsS \
                        "http://127.0.0.1:${TEST_PORT}/" \
                        -o /dev/null; do
                        attempt=$((attempt + 1))
                        if [ "$attempt" -ge 15 ]; then
                            echo "Health check failed."
                            podman logs "$TEST_CONTAINER" || true
                            exit 1
                        fi
                        sleep 1
                    done

                    echo "Health check passed: HTTP 200 OK"
                    curl -fsS \
                      "http://127.0.0.1:${TEST_PORT}/" \
                      -o /dev/null
                '''
            }
        }

        stage('Archive Security Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'security-reports/trivy-report.json',
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'security-reports/trivy-report.json',
                allowEmptyArchive: true
            )
            sh '''
                podman rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true
                rm -f "$REPORT_DIR/image.tar"
            '''
        }

        success {
            echo 'Production review passed: security scan and HTTP health check succeeded.'
        }

        failure {
            echo 'Pipeline failed. Review the failed stage and archived security report.'
        }
    }
}
